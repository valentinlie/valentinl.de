---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content="Valentin Lieberknecht - Information Systems Student & DevOps Enthusiast" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <script defer src="https://umami.valentinl.de/script.js" data-website-id="e3b0ddf8-99f7-4d0e-8708-51c3f856691d"></script>
    <script is:inline>
      (function() {
        const saved = localStorage.getItem('theme');
        const preferred = window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
        document.documentElement.setAttribute('data-theme', saved || preferred);
      })();
    </script>
  </head>
  <body>
    <div class="container">
      <slot />
    </div>
  </body>
</html>

<style is:global>
  :root {
    --color-bg: #110f0d;
    --color-bg-secondary: #1a1714;
    --color-text: #fafafa;
    --color-text-muted: #a1a1aa;
    --color-accent: #3b82f6;
    --color-accent-hover: #60a5fa;
    --color-border: #27272a;
    --color-header-bg: rgba(17, 15, 13, 0.8);
    --font-sans: 'Inter', system-ui, sans-serif;
  }

  [data-theme="light"] {
    --color-bg: #faf8f6;
    --color-bg-secondary: #f0ece8;
    --color-text: #1a1a1a;
    --color-text-muted: #64635e;
    --color-border: #d9d5cf;
    --color-header-bg: rgba(250, 248, 246, 0.8);
  }

  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  html {
    font-family: var(--font-sans);
    background: var(--color-bg);
    color: var(--color-text);
    scroll-behavior: smooth;
  }

  body {
    min-height: 100vh;
    line-height: 1.6;
  }

  .container {
    max-width: 800px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  a {
    color: var(--color-accent);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  a:hover {
    color: var(--color-accent-hover);
  }

  ::selection {
    background: var(--color-accent);
    color: var(--color-text);
  }
</style>
