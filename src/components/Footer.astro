---
const currentYear = new Date().getFullYear();
---

<footer>
  <div class="footer-content">
    <p>&copy; {currentYear} Valentin Lieberknecht. All rights reserved.</p>
  </div>
</footer>

<style>
  footer {
    padding: 3rem 0;
    border-top: 1px solid var(--color-border);
    margin-top: 2rem;
  }

  .footer-content {
    text-align: center;
  }

  .footer-content p {
    color: var(--color-text-muted);
    font-size: 0.9rem;
  }
</style>
