---
const skills = [
  { name: 'Google Cloud', icon: 'simple-icons:googlecloud', color: '#4285F4' },
  { name: 'Terraform', icon: 'simple-icons:terraform', color: '#844FBA' },
  { name: 'Linux', icon: 'simple-icons:linux', color: '#FCC624' },
  { name: 'Docker', icon: 'simple-icons:docker', color: '#2496ED' },
  { name: 'Kubernetes', icon: 'simple-icons:kubernetes', color: '#326CE5' },
  { name: 'Helm', icon: 'simple-icons:helm', color: '#0F1689' },
  { name: 'ArgoCD', icon: 'simple-icons:argo', color: '#EF7B4D' },
  { name: 'Git', icon: 'simple-icons:git', color: '#F05032' },
  { name: 'Python', icon: 'simple-icons:python', color: '#3776AB' },
  { name: 'TypeScript', icon: 'simple-icons:typescript', color: '#3178C6' },
  //{ name: 'REST API', icon: 'api', color: '#009688' },
];

import { Icon } from 'astro-icon/components';
---

<section id="skills" class="skills">
  <h2>Tools & Technologies</h2>
  <p class="section-intro">
    Technologies I work with and am continuously learning to build robust, automated infrastructure.
  </p>

  <div class="marquee-container">
    <div class="marquee-row">
      <div class="marquee-content">
        {skills.map((skill) => (
          <div class="skill-tag" style={`--skill-color: ${skill.color}`}>
            <span class="skill-icon">
              <Icon name={skill.icon} size={20} />
            </span>
            <span class="skill-name">{skill.name}</span>
          </div>
        ))}
        {skills.map((skill) => (
          <div class="skill-tag" style={`--skill-color: ${skill.color}`}>
            <span class="skill-icon">
              <Icon name={skill.icon} size={20} />
            </span>
            <span class="skill-name">{skill.name}</span>
          </div>
        ))}
      </div>
    </div>

    <div class="marquee-row reverse">
      <div class="marquee-content">
        {[...skills].reverse().map((skill) => (
          <div class="skill-tag" style={`--skill-color: ${skill.color}`}>
            <span class="skill-icon">
              <Icon name={skill.icon} size={20} />
            </span>
            <span class="skill-name">{skill.name}</span>
          </div>
        ))}
        {[...skills].reverse().map((skill) => (
          <div class="skill-tag" style={`--skill-color: ${skill.color}`}>
            <span class="skill-icon">
              <Icon name={skill.icon} size={20} />
            </span>
            <span class="skill-name">{skill.name}</span>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .skills {
    padding: 4rem 0;
    overflow: hidden;
  }

  h2 {
    font-size: 2rem;
    font-weight: 700;
    margin-bottom: 0.75rem;
  }

  .section-intro {
    color: var(--color-text-muted);
    margin-bottom: 2.5rem;
    font-size: 1.1rem;
  }

  .marquee-container {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin: 0 -1.5rem;
  }

  .marquee-row {
    overflow: hidden;
    position: relative;
  }

  .marquee-row::before,
  .marquee-row::after {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    width: 100px;
    z-index: 2;
    pointer-events: none;
  }

  .marquee-row::before {
    left: 0;
    background: linear-gradient(to right, var(--color-bg), transparent);
  }

  .marquee-row::after {
    right: 0;
    background: linear-gradient(to left, var(--color-bg), transparent);
  }

  .marquee-content {
    display: flex;
    gap: 1rem;
    animation: scroll 25s linear infinite;
    width: max-content;
  }

  .marquee-row.reverse .marquee-content {
    animation: scroll-reverse 25s linear infinite;
  }

  .marquee-row:hover .marquee-content {
    animation-play-state: paused;
  }

  @keyframes scroll {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }

  @keyframes scroll-reverse {
    0% {
      transform: translateX(-50%);
    }
    100% {
      transform: translateX(0);
    }
  }

  .skill-tag {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    background: var(--color-bg-secondary);
    color: var(--color-text);
    padding: 0.75rem 1.25rem;
    border-radius: 50px;
    font-size: 0.95rem;
    font-weight: 500;
    border: 1px solid var(--color-border);
    white-space: nowrap;
    transition: all 0.3s ease;
  }

  .skill-tag:hover {
    border-color: var(--skill-color);
    transform: scale(1.05);
  }

  .skill-tag:hover .skill-icon {
    color: var(--skill-color);
  }

  .skill-icon {
    width: 24px;
    height: 24px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-text-muted);
    transition: color 0.3s ease;
  }

  .skill-icon :global(svg) {
    width: 100%;
    height: 100%;
  }

  .skill-name {
    color: var(--color-text);
  }
</style>
